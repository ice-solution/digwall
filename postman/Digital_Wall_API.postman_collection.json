                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/messages?status=completed&page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "messages"],
              "query": [
                {
                  "key": "status",
                  "value": "completed"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "List completed messages only."
          },
          "response": []
        },
        {
          "name": "GET Admin Messages (slot)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/messages?status=slot&page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "messages"],
              "query": [
                {
                  "key": "status",
                  "value": "slot"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "List slot messages only."
          },
          "response": []
        }
      ]
    }
  ]
}
